{
  "_comment": "Default Virtual Office config — customize during setup or via environment variables",
  "office": {
    "name": "Virtual Office",
    "port": 8090,
    "wsPort": 8091,
    "wsPath": "/ws"
  },
  "openclaw": {
    "gatewayUrl": "ws://127.0.0.1:18789",
    "gatewayHttp": "http://127.0.0.1:18789"
  },
  "presence": {
    "statusDir": "/data",
    "inferenceEnabled": true,
    "inferenceIdleTimeoutSec": 300
  },
  "weather": {
    "provider": "qweather",
    "location": "北京市,海淀区",
    "latitude": 39.96,
    "longitude": 116.3,
    "fallbackEnabled": true,
    "qweather": {
      "apiHost": "",
      "apiKey": ""
    }
  },
  "features": {
    "pcMetrics": true,
    "smsPanel": false,
    "browserPanel": true,
    "whisper": false,
    "apiUsage": false
  },
  "pcMetrics": {
    "url": "http://127.0.0.1:8099"
  },
  "whisper": {
    "url": "http://127.0.0.1:8087"
  },
  "browser": {
    "cdpUrl": "http://127.0.0.1:9224",
    "viewerUrl": "https://localhost:6901"
  },
  "sms": {
    "ownerAgentId": null,
    "agentId": null,
    "twilioAccountSid": null,
    "twilioAuthToken": null,
    "fromNumber": null
  },
  "codex": {
    "enabled": true,
    "homePath": "~/.codex",
    "binary": "codex",
    "workspaceRoot": "/data/codex-agents",
    "mainWorkspace": "/data/codex-main",
    "timeoutSec": 900,
    "model": "",
    "sandbox": "workspace-write",
    "approvalPolicy": "never",
    "preferAppServer": true,
    "includeMain": false,
    "includeNativeAgents": true,
    "registerNativeAgents": true
  },
  "claudeCode": {
    "enabled": true,
    "homePath": "~/.claude",
    "binary": "claude",
    "workspaceRoot": "/data/claude-code-agents",
    "mainWorkspace": "/data/claude-code-main",
    "timeoutSec": 900,
    "model": "",
    "permissionMode": "acceptEdits",
    "includeMain": false,
    "includeNativeAgents": true,
    "registerNativeAgents": true
  }
}
